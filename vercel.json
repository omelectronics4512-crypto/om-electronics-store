{
  "version": 2,
  "cleanUrls": true,
  "functions": {
    "index.js": {
      "includeFiles": "{*.html,admin/**,*.png,*.js}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js?path=$1" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ]
}
